# Ai platform Docker Compose
# cp .env.example .env && edit cluster endpoints

# ---------- Local image names (default: build on server, no remote registry) ----------
IMAGE_PREFIX=ai-platform
IMAGE_TAG=0.1.258-SNAPSHOT
# Examples:
#   IMAGE_PREFIX=ai-platform          -> ai-platform/ai-backend:0.1.258-SNAPSHOT
#   IMAGE_PREFIX=my-registry.com/team   -> my-registry.com/team/ai-backend:0.1.258-SNAPSHOT

# Ports
USER_WEB_PORT=5173
ADMIN_WEB_PORT=5174

# ---------- Cluster MySQL (required) ----------
MYSQL_URL=jdbc:mysql://your-mysql-host:3306/ai?useUnicode=true&characterEncoding=utf8&connectionTimeZone=%2B08%3A00&forceConnectionTimeZoneToSession=true
MYSQL_USERNAME=ai
MYSQL_PASSWORD=change_me

# ---------- Cluster Redis (required) ----------
SPRING_DATA_REDIS_HOST=your-redis-host
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_DATABASE=0

# ---------- Cluster Milvus (required) ----------
AI_MILVUS_HOST=your-milvus-host
AI_MILVUS_PORT=19530
AI_MILVUS_TOKEN=
AI_MILVUS_SECURE=false

# ---------- Cluster MinIO (required) ----------
MINIO_ENDPOINT=http://your-minio-host:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ---------- Elasticsearch (created by this compose) ----------
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.13.3
# Mirror example: docker.m.daocloud.io/docker.elastic.co/elasticsearch/elasticsearch:8.13.3
ES_JAVA_OPTS=-Xms512m -Xmx512m
ES_XPACK_SECURITY_ENABLED=false
AI_RAG_ES_HOST_PORTS=elasticsearch:9200
AI_RAG_ES_CLUSTER_NAME=es-ai
AI_RAG_ES_USERNAME=
AI_RAG_ES_PASSWORD=

# ---------- Security (change in production) ----------
AI_AUTH_JWT_LOCAL_SECRET=change-me-please-use-32bytes-minimum!!
AI_LLM_MODEL_KEY_SECRET=

# ---------- Other ----------
AI_DISCOVERY_ENABLED=false
AI_ROCKETMQ_ENABLED=false
AI_DEFAULT_TENANT_ID=1
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0
