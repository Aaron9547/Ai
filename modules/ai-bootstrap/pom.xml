<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.aaron.cloud</groupId>
        <artifactId>Ai</artifactId>
        <version>0.1.258-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>ai-bootstrap</artifactId>
    <name>ai-bootstrap</name>
    <description>聚合启动模块</description>

    <properties>
        <docker.image.ref>${docker.image.registry}/${docker.image.name}:${docker.image.tag}</docker.image.ref>
        <docker.exec.skip>false</docker.exec.skip>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.aaron.cloud</groupId>
            <artifactId>ai-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aaron.cloud</groupId>
            <artifactId>ai-remoting</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aaron.cloud</groupId>
            <artifactId>ai-gateway</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aaron.cloud</groupId>
            <artifactId>ai-identity</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aaron.cloud</groupId>
            <artifactId>ai-model</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aaron.cloud</groupId>
            <artifactId>ai-file</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aaron.cloud</groupId>
            <artifactId>ai-rag</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aaron.cloud</groupId>
            <artifactId>ai-job</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aaron.cloud</groupId>
            <artifactId>ai-chat</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aaron.cloud</groupId>
            <artifactId>ai-mcp</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aaron.cloud</groupId>
            <artifactId>ai-notification</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aaron.cloud</groupId>
            <artifactId>ai-prompt</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aaron.cloud</groupId>
            <artifactId>ai-eval</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.aaron.cloud.AiApplication</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-docker-context</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/docker"/>
                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                      tofile="${project.build.directory}/docker/app.jar"
                                      overwrite="true"/>
                                <copy file="${project.basedir}/Dockerfile"
                                      tofile="${project.build.directory}/docker/Dockerfile"
                                      overwrite="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 大体积 fat-jar（~400MB）在 Windows 上走 fabric8 HTTP 上传易触发 chunk 错误；改用本机 docker CLI -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>docker-build</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${docker.exec.skip}</skip>
                            <executable>docker</executable>
                            <workingDirectory>${project.build.directory}/docker</workingDirectory>
                            <arguments>
                                <argument>build</argument>
                                <argument>-t</argument>
                                <argument>${docker.image.ref}</argument>
                                <argument>.</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>docker-push</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${docker.exec.skip}</skip>
                            <executable>docker</executable>
                            <arguments>
                                <argument>push</argument>
                                <argument>${docker.image.ref}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
