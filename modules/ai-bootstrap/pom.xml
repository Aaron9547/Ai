            <groupId>com.aaron.cloud</groupId>
            <artifactId>ai-gateway</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aaron.cloud</groupId>
            <artifactId>ai-identity</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aaron.cloud</groupId>
            <artifactId>ai-model</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aaron.cloud</groupId>
            <artifactId>ai-file</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aaron.cloud</groupId>
            <artifactId>ai-rag</artifactId>
