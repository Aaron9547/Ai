<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>com.aaron.cloud</groupId>
    <artifactId>Ai</artifactId>
    <version>0.1.258-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>Ai</name>
    <description>Ai platform (multi-tenant AI middleware)</description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <maven.compiler.enablePreview>false</maven.compiler.enablePreview>
        <mybatis-plus.version>3.5.16</mybatis-plus.version>
        <mybatis-plus-join.version>1.5.7</mybatis-plus-join.version>
        <spring-cloud.version>2024.0.0</spring-cloud.version>
        <mcp-sdk.version>1.1.1</mcp-sdk.version>
        <springdoc.version>2.8.5</springdoc.version>
        <rocketmq-spring.version>2.3.3</rocketmq-spring.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <archunit.version>1.4.2</archunit.version>
        <ip2region.version>2.7.0</ip2region.version>
        <docker.image.registry>registry.cn-guangzhou.aliyuncs.com/liangchulong</docker.image.registry>
        <docker.image.name>ai-backend</docker.image.name>
        <docker.image.tag>${project.version}</docker.image.tag>
        <docker.image.ref>${docker.image.registry}/${docker.image.name}:${docker.image.tag}</docker.image.ref>
        <docker.exec.skip>true</docker.exec.skip>
        <exec-maven-plugin.version>3.5.0</exec-maven-plugin.version>
        <rapidocr.version>0.0.7</rapidocr.version>
        <!-- 与 tika-parsers-standard-package 2.9.2 对齐（其 PDF 解析基于 PDFBox 2.0.31）；勿升到 3.x 直至 Tika 3.x -->
        <pdfbox.version>2.0.31</pdfbox.version>
    </properties>

